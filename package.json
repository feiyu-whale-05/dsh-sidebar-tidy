{
  "name": "dsh-sidebar-tidy",
  "version": "0.2.2-rc.3",
  "private": true,
  "type": "module",
  "description": "左侧栏精简 + 移动抽屉布局 + 打包融合 DSH-better-sidebar 右侧工作台（文件树/编辑器/Git/任务/终端）；日志写入 D:\\DSH-plugins\\log\\dsh-sidebar-tidy。",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "dependencies": {
    "dsh-better-sidebar": "0.32.1"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  }
}
